#!/usr/bin/env python3
"""NEXUS launcher -- runs from a source checkout with zero installation.

Usage:
    ./nexus                     interactive session
    ./nexus -p "question"       one-shot
    ./nexus demo                offline guided tour
    ./nexus selftest            run the test suite

Optional install (so `nexus` works from anywhere):
    ln -s "$PWD/nexus" ~/.local/bin/nexus
"""

from __future__ import annotations

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from nexuscli.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
